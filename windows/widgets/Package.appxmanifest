<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:virtualization="http://schemas.microsoft.com/appx/manifest/virtualization/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 com virtualization rescap">
  <Identity Name="Wocli.Music.WidgetsPreview"
    Publisher="CN=wocli-music.WidgetsPreview"
    Version="0.4.11.0" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>wocli 系统歌词预览</DisplayName>
    <PublisherDisplayName>wocli-music</PublisherDisplayName>
    <Description>Preview of locally supplied lyrics in the Windows Widgets feed.</Description>
    <Logo>Assets\StoreLogo.png</Logo>
    <!-- Share config, endpoint and diagnostics with the unpackaged Rust player.
         Without this exclusion, newly created AppData files can be virtualized.
         This narrow Windows 11 exclusion does not change other app directories. -->
    <virtualization:FileSystemWriteVirtualization>
      <virtualization:ExcludedDirectories>
        <virtualization:ExcludedDirectory>$(KnownFolder:LocalAppData)\wocli-music</virtualization:ExcludedDirectory>
      </virtualization:ExcludedDirectories>
    </virtualization:FileSystemWriteVirtualization>
  </Properties>
  <Dependencies>
    <!-- Feed host prerequisite; MaxVersionTested is a compatibility declaration,
         not evidence that this preview has passed UI tests on that Windows build. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22631.2787" MaxVersionTested="10.0.26100.0" />
    <!-- build_windows_widgets.ps1 adds PackageDependency using the exact identity
         parsed from the restored, Microsoft-signed Windows App Runtime MSIX. -->
  </Dependencies>
  <Resources>
    <Resource Language="en-us" />
    <Resource Language="zh-cn" />
  </Resources>
  <Applications>
    <Application Id="WocliWidgets" Executable="Wocli.Widgets.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="wocli 系统歌词预览"
        Description="Local lyrics feed provider; enabled through Windows Widgets settings."
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        BackgroundColor="transparent" AppListEntry="none" />
      <Extensions>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="Wocli.Widgets.exe"
              Arguments="-RegisterProcessAsComServer" DisplayName="wocli lyrics feed provider">
              <com:Class Id="8B3EF0C4-86E8-4D42-A154-76492840B5EB" DisplayName="wocli lyrics feed provider" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>
        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension Name="com.microsoft.windows.widgets.feeds"
            Id="com.wocli.music.lyrics" DisplayName="wocli 歌词" PublicFolder="Public">
            <uap3:Properties>
              <FeedProvider Id="com.wocli.music.lyrics" DisplayName="wocli 歌词"
                Description="Lyrics from the local wocli player."
                Icon="ms-appx:///Assets/StoreLogo.png">
                <Activation>
                  <CreateInstance ClassId="8B3EF0C4-86E8-4D42-A154-76492840B5EB" />
                </Activation>
                <Definitions>
                  <Definition Id="Wocli_Lyrics" DisplayName="wocli 歌词"
                    Description="Current song and lyrics from this computer."
                    ContentUri="https://wocli.invalid/lyrics"
                    WebRequestFilter="https://wocli.invalid/*"
                    Icon="ms-appx:///Assets/StoreLogo.png"
                    ExclusiveRegions="AT,BE,BG,HR,CY,CZ,DK,EE,FI,FR,DE,GR,HU,IS,IE,IT,LV,LI,LT,LU,MT,NL,NO,PL,PT,RO,SK,SI,ES,SE" />
                </Definitions>
              </FeedProvider>
            </uap3:Properties>
          </uap3:AppExtension>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
</Package>
